# Copy to .env.local for local development. Vite only exposes VITE_* variables
# to the client, and inlines them at build time rather than at container start.

# Where the Express API lives. In Docker this stays /api and nginx proxies it
# to the backend container. During `npm run dev`, Vite proxies /api to :3000.
VITE_API_BASE_URL=/api

# `http` talks to VITE_API_BASE_URL (the Express API, via Google sign-in).
# `mock` serves seeded fixtures from src/data/transports/mockTransport.js so the
# UI runs with no backend.
VITE_API_MODE=http

# Container-only, read by nginx at startup rather than by Vite. Where nginx
# forwards /api requests; set it to the backend's compose service name.
API_UPSTREAM=http://api:3000
