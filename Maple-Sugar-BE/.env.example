# Copy to .env for local development. Never commit the real .env.

NODE_ENV=development
PORT=3000
# LOG_LEVEL=debug

# Postgres. Inside Compose this host is the service name `db` on the Docker
# network. The compose file overrides this with the maple role when the API
# container starts, so a laptop username is never required.
DATABASE_URL=postgresql://maple:maple@db:5432/maple_sugaring

# Redis. Inside Compose the host is the service name `cache`.
REDIS_URL=redis://cache:6379

# Signs the short-lived access-token JWT. This is the API's own key, not a
# shared credential — each environment should have its own, and it must never
# be committed. In dev you can leave it blank: a throwaway default is used when
# NODE_ENV is not production, since a dev token has no value off your machine.
# In production it is REQUIRED and injected at deploy time (see the deploy
# workflow). Generate one with: openssl rand -base64 48
JWT_SECRET=
# Access token lifetime in minutes. Short by design; the frontend silently
# refreshes it from the refresh cookie.
ACCESS_TOKEN_TTL_MINUTES=15
# Refresh token lifetime in days. This database-backed token is what actually
# keeps a user signed in, and the only one that can be revoked per-session.
REFRESH_TOKEN_TTL_DAYS=30

# Google OAuth 2.0 web client. Rotate the secret if it has ever been shared.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Browser-facing base URL of this API, used to build the OAuth redirect_uri.
# It must byte-for-byte match a redirect URI registered in the Google Cloud
# Console, and it is NOT the container's internal address: nginx (and the Vite
# dev proxy) serve the API under /api, so the browser only ever sees this prefix.
#   Docker stack:    http://localhost:8080/api
#   Vite dev server: http://localhost:5173/api
# Use the host and port the browser actually opens. Containers talk to each
# other by service name (api, db, cache); this URL is only for the browser
# and the Google redirect URI.
PUBLIC_API_URL=http://localhost:8080/api

# Authorized redirect URIs that must be registered on the Google OAuth client
# (APIs & Services → Credentials → the web client):
#   {PUBLIC_API_URL}/auth/google/callback
#   {PUBLIC_API_URL}/auth/google/calendar/callback
#
# Also enable Google Calendar API and add the scope
# https://www.googleapis.com/auth/calendar.events on the OAuth consent screen.

# Where to send the browser once the OAuth handshake succeeds.
PUBLIC_WEB_URL=http://localhost:8080

# Only these email domains may sign in. Comma-separated; empty allows any.
ALLOWED_EMAIL_DOMAINS=g.rit.edu,rit.edu

# Extra origins allowed to call the API with credentials. PUBLIC_WEB_URL is
# always allowed. Same-origin deployments behind nginx need nothing here.
CORS_ORIGINS=

# OpenWeather key for live sugarbush conditions. Leave blank to hide live weather.
OPENWEATHER_API_KEY=

# Shared secret the Raspberry Pi gateways send on POST /ingest.
# Generate with: openssl rand -base64 32
# Leave blank to refuse sensor pushes (the route answers 503).
GATEWAY_INGEST_TOKEN=

# Comma-separated addresses promoted to Admin on every boot. Not a laptop path.
BOOTSTRAP_ADMIN_EMAILS=

# Sugarbush coordinates sent to OpenWeather. Defaults are the RIT stand.
SUGARBUSH_LATITUDE=43.084
SUGARBUSH_LONGITUDE=-77.680
