# Copy to .env and edit. FORWARD_TO_SERVER stays off until the local page
# shows JSON lines from the gateway Heltec.

GATEWAY_SERIAL=/dev/ttyACM0
GATEWAY_BAUD=115200

DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8080

# 0 = USB serial + local page only (default). 1 = also POST /ingest.
FORWARD_TO_SERVER=0
GATEWAY_CODE=GW-ALUMNI
MAPLE_API_URL=https://maplesugaring01.webdev.gccis.rit.edu/api/ingest

# Must match GATEWAY_INGEST_TOKEN on the API. Generate a fresh value, for example:
#   openssl rand -base64 32
# Do not commit the real token.
GATEWAY_INGEST_TOKEN=
