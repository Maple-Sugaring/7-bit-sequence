# Copy to .env and edit. FORWARD_TO_SERVER stays off until the dummy app
# shows packets arriving from the Heltec.

LORA_SERIAL=/dev/serial0
LORA_FREQ=915
LORA_AIR_SPEED=9600
LORA_RSSI=1

DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8080

# 0 = radio + dummy app only (default). 1 = also POST to the maple API.
FORWARD_TO_SERVER=0
MAPLE_API_URL=https://maplesugaring01.webdev.gccis.rit.edu/api/metrics
MAPLE_BEARER_TOKEN=
